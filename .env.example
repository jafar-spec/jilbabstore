# ───────────────────────────────────────────────────────────────────────────
# Jilbab Store — environment variables
#
# Copy to `.env.local` for local dev and fill in real values.
# In production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables (Production + Preview).
# NEVER commit real values — this file is the value-less template only.
# ───────────────────────────────────────────────────────────────────────────

# ═══ REQUIRED ═══════════════════════════════════════════════════════════════

# Firebase Admin SDK — the FULL service-account JSON, single-lined, as a string.
# Powers all server routes (order creation, transitions, returns, cancel, cron).
# Get it from: Firebase Console → Project Settings → Service accounts →
# "Generate new private key". Paste the entire JSON as ONE value.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase client config (safe to expose; restricted by Firestore rules + App Check).
# lib/firebase.js has fallbacks, but set these explicitly in prod.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Canonical site URL (used for SEO/structured-data/links). e.g. https://jilbab.store
NEXT_PUBLIC_SITE_URL=

# ═══ RECOMMENDED ════════════════════════════════════════════════════════════

# Transactional email (order confirmations, return/refund, low-stock). Resend.
RESEND_API_KEY=
EMAIL_FROM=                      # e.g. "Jilbab Store <orders@yourdomain.com>"

# Protects the Vercel cron endpoints (/api/cron/*). Vercel auto-sends this as a
# Bearer token to scheduled routes when set. Use a long random string.
CRON_SECRET=

# Firebase App Check (reCAPTCHA v3) — enforces Firestore security in production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ═══ OPTIONAL (features degrade gracefully if unset) ════════════════════════

# SMS notifications (Twilio). No-ops if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                     # sender phone or alphanumeric sender id

# Algolia search. Falls back to local matching if unset.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_WRITE_KEY=               # server-side, for scripts/reindex-algolia.mjs

# Analytics / monitoring
NEXT_PUBLIC_GA_ID=               # Google Analytics 4 measurement id
NEXT_PUBLIC_SENTRY_DSN=          # Sentry error reporting

# PayPal — set the client id to enable the PayPal redirect at checkout.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── Card payments (provider-agnostic; OFF by default = "structure-ready") ───
# Leave PAYMENT_PROVIDER unset to keep card charges disabled (the UI shows a
# "card payments coming soon" message). To go live, wire the gateway in
# app/api/payments/charge/route.js + the webhook, then set these.
PAYMENT_PROVIDER=                # e.g. "stripe" | "creditguard"
STRIPE_SECRET_KEY=               # if using Stripe
PAYMENT_WEBHOOK_SECRET=          # gateway webhook signing secret
NEXT_PUBLIC_CARD_PAYMENTS_ENABLED=   # set to "false" to hide the card option entirely

# CreditGuard (Israeli gateway) — present in the project env but NOT yet wired
# in code. Kept for when card payments go live via CreditGuard.
CG_ENDPOINT=
CG_MID=
CG_TERMINAL=
CG_USER=
CG_PASSWORD=

# Courier portal access key (if used by the courier flow)
NEXT_PUBLIC_COURIER_KEY=

# ─── Dev-only ────────────────────────────────────────────────────────────────
# App Check debug bypass for local testing (NEVER set true in production).
NEXT_PUBLIC_APPCHECK_DEBUG=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
